<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Debug Dojo</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#070b10;--p:#0d141c;--l:#1c2a37;--t:#dbe7f0;--m:#8196a8;--g:#39ff88;--c:#27e0ff;--r:#ff6b78;--y:#ffd166;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*:before,*:after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--t);font:16px/1.6 'Bricolage Grotesque',system-ui,sans-serif;overflow-x:hidden}
a{color:var(--c);text-decoration:none}
:focus-visible{outline:2px solid var(--c);outline-offset:2px}
.mono,.term,textarea{font-family:'JetBrains Mono',ui-monospace,Menlo,monospace}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}
header.top{display:flex;justify-content:space-between;align-items:center;padding:14px 20px;max-width:1120px;margin:0 auto;position:relative;z-index:5}
header b{font-size:20px;color:var(--g);text-shadow:0 0 18px #39ff8866}
header nav{display:flex;gap:18px}header nav a{color:var(--t)}
.btn{display:inline-block;border:1px solid var(--l);background:var(--p);color:var(--t);padding:10px 18px;border-radius:10px;font:600 15px inherit;font-family:inherit;cursor:pointer;transition:.2s}
.btn:hover{border-color:var(--c);transform:translateY(-2px)}
.btn.glow{background:linear-gradient(135deg,var(--g),var(--c));color:#04120a;border:0;padding:15px 30px;font-size:18px;font-weight:800;box-shadow:0 0 28px #39ff8888,0 0 60px #27e0ff44;animation:pl 2.6s infinite}
@keyframes pl{50%{box-shadow:0 0 40px #39ff88cc,0 0 90px #27e0ff66}}
.hero{position:relative;padding:50px 0 80px;overflow:hidden}
.hero canvas{position:absolute;inset:0;width:100%;height:100%}
.hero:before{content:"";position:absolute;inset:0;background:linear-gradient(#1c2a3755 1px,transparent 1px) 0 0/44px 44px,linear-gradient(90deg,#1c2a3755 1px,transparent 1px) 0 0/44px 44px;-webkit-mask:radial-gradient(ellipse at 50% 40%,#000 20%,transparent 75%);mask:radial-gradient(ellipse at 50% 40%,#000 20%,transparent 75%)}
.hg{position:relative;display:grid;gap:40px;align-items:center}
@media(min-width:900px){.hg{grid-template-columns:1.05fr 1fr}}
h1{font-size:clamp(40px,7vw,76px);line-height:1;margin:0 0 18px;font-weight:800;letter-spacing:-.03em;background:linear-gradient(120deg,#fff,var(--g) 45%,var(--c));-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p.lead{color:var(--m);font-size:19px;max-width:520px;margin:0 0 28px}
.demo{position:relative;background:#05090dcc;border:1px solid var(--l);border-radius:14px;box-shadow:0 0 60px #27e0ff22;overflow:hidden}
.demo .tb,.term .tb{display:flex;gap:6px;padding:10px 14px;border-bottom:1px solid var(--l);font-size:12px;color:var(--m);align-items:center}
.tb i{width:10px;height:10px;border-radius:50%;background:#ff5f57}.tb i+i{background:#febc2e}.tb i+i+i{background:#28c840}
.demo .bd{padding:16px;min-height:150px;font:14px/1.7 'JetBrains Mono',monospace}
.ln.e,.e{color:var(--r)}.ln.o,.o{color:var(--g)}.pr{color:var(--g)}
.cur{display:inline-block;width:8px;height:15px;background:var(--g);vertical-align:-2px;animation:bk 1s steps(1) infinite}@keyframes bk{50%{opacity:0}}
.xp{position:absolute;right:16px;top:50px;background:var(--g);color:#04120a;font-weight:800;padding:6px 14px;border-radius:999px;box-shadow:0 0 24px var(--g);animation:up 2.4s forwards}
@keyframes up{0%{transform:translateY(20px);opacity:0}15%{transform:none;opacity:1}85%{opacity:1}100%{transform:translateY(-30px);opacity:0}}
.stats{display:flex;flex-wrap:wrap;justify-content:space-around;gap:20px;padding:26px 20px;border-block:1px solid var(--l);background:#0a1118}
.stats div{text-align:center}.stats b{display:block;font-size:34px;color:var(--c)}.stats span{color:var(--m)}
section.s{padding:70px 0}h2{font-size:clamp(28px,4vw,40px);margin:0 0 30px;letter-spacing:-.02em}
.cards{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}
.card{background:var(--p);border:1px solid var(--l);border-radius:14px;padding:22px;transition:.25s}
.cards .card:hover,.cc:hover{border-color:var(--g);box-shadow:0 0 30px #39ff8822;transform:translateY(-4px)}
.card svg{width:40px;height:40px;stroke:var(--g);fill:none;stroke-width:1.6;margin-bottom:10px}
.card h3{margin:0 0 6px}.card p{margin:0;color:var(--m)}
.belts{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.bt{flex:1;min-width:120px;padding:16px 10px;border-radius:10px;text-align:center;font-weight:800;color:#05090d}
.rv{opacity:0;transform:translateY(24px);transition:.6s}.rv.in{opacity:1;transform:none}
footer{border-top:1px solid var(--l);padding:28px 20px;text-align:center;color:var(--m)}
.top2{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));margin:10px 0 24px}
.top2 .card b{font-size:26px;display:block}.bar{height:8px;background:var(--l);border-radius:9px;overflow:hidden;margin-top:8px}.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--g),var(--c))}
.cc{display:block;color:var(--t);background:var(--p);border:1px solid var(--l);border-radius:14px;padding:18px;transition:.25s}
.chip{font-size:12px;padding:2px 10px;border-radius:99px;border:1px solid var(--c);color:var(--c)}
.done{border-color:#39ff8866}.done .chip{border-color:var(--g);color:var(--g)}
ul.bg{list-style:none;padding:0;margin:0;display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(170px,1fr))}
ul.bg li{padding:12px;border:1px dashed var(--l);border-radius:10px;opacity:.45}ul.bg li.on{opacity:1;border:1px solid var(--y)}ul.bg span{display:block;font-size:13px;color:var(--m)}
.lb div{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--l)}.lb .me{color:var(--g);font-weight:800}
.bar2{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin:10px 0 16px}.bar2 b{flex:1}
.grid{display:grid;gap:16px}@media(min-width:960px){.grid{grid-template-columns:1fr 1.25fr}}
.term{background:#04080c;border:1px solid var(--l);border-radius:12px;overflow:hidden;display:flex;flex-direction:column;height:min(70vh,560px);min-height:360px}
.out{flex:1;overflow:auto;padding:12px;font-size:13.5px;line-height:1.55;white-space:pre-wrap;word-break:break-word}
.in{display:flex;gap:8px;padding:10px 12px;border-top:1px solid var(--l);font-size:13.5px}.in span{color:var(--g);white-space:nowrap}
.in input{flex:1;min-width:0;background:none;border:0;color:var(--t);font:inherit;outline:0}
textarea{width:100%;height:230px;background:#04080c;color:var(--t);border:1px solid var(--l);border-radius:8px;padding:10px;font-size:13px;resize:vertical}
.tabs button{background:none;border:0;border-bottom:2px solid transparent;color:var(--m);padding:6px 10px;cursor:pointer;font:13px 'JetBrains Mono',monospace}.tabs button[aria-selected=true]{color:var(--g);border-color:var(--g)}
.hint{border-left:3px solid var(--y);padding:6px 12px;margin:8px 0;color:#f3e3b8;background:#ffd16610}
.modal{position:fixed;inset:0;background:#000b;display:grid;place-items:center;z-index:20;padding:16px}
.modal .card{max-width:520px;width:100%;border-color:var(--g);box-shadow:0 0 60px #39ff8855;animation:pop .4s}@keyframes pop{from{transform:scale(.85);opacity:0}}
.big{font-size:44px;font-weight:800;color:var(--g)}
.cf{position:fixed;top:40%;left:50%;width:8px;height:8px;border-radius:2px;animation:cf 1.4s ease-out forwards;z-index:21}
@keyframes cf{to{transform:translate(var(--x),var(--y)) rotate(540deg);opacity:0}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}.rv{opacity:1;transform:none}}
.auth{max-width:420px;margin:30px auto 60px;box-shadow:0 0 50px #27e0ff22}.auth h2{margin:4px 0 12px}
.seg{display:flex;gap:6px;margin:6px 0 10px}.seg button{flex:1;padding:9px;background:var(--bg);border:1px solid var(--l);color:var(--m);border-radius:8px;cursor:pointer;font:inherit}.seg button[aria-selected=true]{color:var(--g);border-color:var(--g)}
label{display:block;margin:12px 0;color:var(--m);font-size:14px}.f{width:100%;margin-top:4px;background:#04080c;border:1px solid var(--l);border-radius:8px;padding:11px;color:var(--t);font:15px 'JetBrains Mono',monospace}.f:focus{border-color:var(--c);outline:0;box-shadow:0 0 0 3px #27e0ff33}
.btn.sm{padding:4px 10px}
.chat{margin-top:14px}.cmsg{padding:6px 0;border-bottom:1px solid var(--l);font-size:14px;white-space:pre-wrap}.cmsg.me{color:var(--c)}.cmsg.ai{color:var(--t)}
[data-theme=light]{--bg:#f3f6f9;--p:#fff;--l:#d5dee6;--t:#14202b;--m:#51657a;--g:#0a9d57;--c:#0a7f9f;--r:#c62f3d;--y:#b7791f;color-scheme:light}
[data-theme=light] .term,[data-theme=light] textarea,[data-theme=light] .demo{--t:#dbe7f0;--m:#8196a8;--g:#39ff88;--c:#27e0ff}
[data-theme=light] h1{background:linear-gradient(120deg,#0b2e22,#0a7a4a 50%,#0a6f86);-webkit-background-clip:text;background-clip:text}
[data-theme=light] .stats{background:#e8eef3}[data-theme=light] .btn.glow{color:#fff}
</style></head><body>
<header class="top"><a href="#home" class="mono"><b>&gt;_ Debug Dojo</b></a><nav><a href="#dojo">Dojo</a><a href="#lab">Linux Lab</a><a href="#login" id="au">Log in</a><button class="btn sm" id="th" aria-label="Toggle light or dark theme">◐</button><button class="btn sm" id="sn" aria-label="Toggle typing sound" aria-pressed="false">🔇</button></nav></header>
<main id="app"></main>
<script>
const $=(s,r=document)=>r.querySelector(s),HOME='/home/dojo';
let SV={xp:0,done:{},streak:0,last:''},S,fs,TM;
try{Object.assign(SV,JSON.parse(localStorage.getItem('dd1')||'{}'))}catch(e){}
const save=()=>{try{localStorage.setItem('dd1',JSON.stringify(SV))}catch(e){}};
const day=(o=0)=>new Date(Date.now()-o*864e5).toISOString().slice(0,10);
const BELTS=[['White',0,'#e8eef3'],['Yellow',100,'#ffd166'],['Green',300,'#39ff88'],['Brown',550,'#c08457'],['Black',850,'#6b7c8c']];
const belt=x=>BELTS.filter(b=>b[1]<=x).pop();
const dn=()=>Object.keys(SV.done).length,fmt=s=>String(s/60|0).padStart(2,'0')+':'+String(s%60).padStart(2,'0');
const stk=()=>SV.last===day()||SV.last===day(1)?SV.streak:0;
const BADGES=[['First Blood','Solve any challenge',()=>dn()>0],['Clean Run','Solve with zero hints',()=>Object.values(SV.done).some(d=>d.h===0)],['Speed Demon','Solve in under 90s',()=>Object.values(SV.done).some(d=>d.t<90)],['On Fire','3-day streak',()=>stk()>=3],['Dojo Master','Solve every challenge',()=>dn()>=CH.length]];
const RIV=[['neo_root',520],['kernel_kat',340],['sudo_sam',190],['bash_bunny',90]];
const win=()=>{if(S&&S.ch&&!S.won){S.won=1;S.onWin&&S.onWin()}};
/* ---------- challenges ---------- */
const AUTHLOG=(()=>{const L=[],t=n=>'Oct 23 10:'+String(n).padStart(2,'0')+':00';let n=0;for(let i=0;i<14;i++)L.push(`${t(n++)} dojo sshd[812]: Failed password for root from 203.0.113.9 port ${4000+i} ssh2`);for(let i=0;i<3;i++)L.push(`${t(n++)} dojo sshd[815]: Failed password for admin from 198.51.100.7 port ${5000+i} ssh2`);L.push(`${t(n++)} dojo sshd[820]: Accepted publickey for dojo from 10.0.0.5 port 6001 ssh2`);L.push(`${t(n++)} dojo sshd[821]: Failed password for dojo from 10.0.0.5 port 6002 ssh2`);return L.join('\n')+'\n'})();
const CH=[
{id:'perm',cat:'Permissions',title:'Permission denied',xp:50,edit:[],story:'Your deploy script refuses to run. Run it, read the error, then fix it the Linux way.',files:{'deploy.sh':{c:'#!/bin/bash\necho "Deploying build 42"\n',m:'rw-r--r--',run:()=>{win();return 'Deploying build 42...\n✔ Deployed to production!'}}},hints:['Try ./deploy.sh first. Then ls -l deploy.sh and look at the x bits.','The file has no execute permission.','chmod +x deploy.sh'],why:'Linux only runs a file if its execute bit is set. ls -l showed -rw-r--r-- (no x). chmod +x adds execute permission so the shell may launch it.'},
{id:'sshkey',cat:'Permissions',title:'Unprotected private key',xp:60,edit:[],story:'You cannot log in to the prod server. SSH keeps rejecting your key. Try: ssh prod',files:{'.ssh/id_rsa':{c:'-----BEGIN DEMO KEY-----\nnot-a-real-key\n',m:'rw-r--r--'}},hints:['Read the SSH warning carefully. Who is able to read the key right now?','A private key must be readable by its owner only.','chmod 600 ~/.ssh/id_rsa then ssh prod'],why:'SSH refuses a private key that other users can read, because anyone on the machine could copy it and impersonate you. Mode 600 (rw-------) leaves access to the owner only.'},
{id:'secret',cat:'Permissions',title:'Secrets open to everyone',xp:60,edit:[],story:'A security audit flagged your home folder. Run ./audit.sh, see what is exposed, and lock it down.',files:{'db_password.txt':{c:'S3cr3t!\n',m:'rw-rw-rw-'},'backup.sql':{c:'-- full database dump\n',m:'rwxrwxrwx'},'audit.sh':{c:'#!/bin/sh\n',m:'rwxr-xr-x',run:()=>{const a=fs[HOME+'/db_password.txt'],b=fs[HOME+'/backup.sql'],o1=!!a&&a.m==='rw-------',o2=!!b&&b.m.slice(6)==='---',o=[o1?'✔ db_password.txt is private (600)':'✘ db_password.txt is accessible to others: '+(a?a.m:'missing'),o2?'✔ backup.sql is not world-accessible':'✘ backup.sql is world-accessible: '+(b?b.m:'missing')];if(o1&&o2){win();o.push('✔ audit passed')}return o.join('\n')}}},hints:['ls -l shows who can read and write each file: owner, group, others.','Passwords: owner only. Backups: nothing for others.','chmod 600 db_password.txt and chmod 640 backup.sql, then ./audit.sh'],why:'The last three permission characters are "others", meaning every user on the system. Passwords should be 600 (owner only), and backups must never be readable by others (640 or 600).'},
{id:'sshd',cat:'Hardening',title:'Harden the SSH server',xp:80,edit:['/etc/ssh/sshd_config'],story:'Auditors call your SSH server a soft target. Run ./ssh-audit.sh, fix /etc/ssh/sshd_config in the editor, save, and audit again.',files:{'/etc/ssh/sshd_config':{c:'Port 22\nPermitRootLogin yes\nPasswordAuthentication yes\nPermitEmptyPasswords yes\nX11Forwarding yes\n'},'ssh-audit.sh':{c:'#!/bin/sh\n',m:'rwxr-xr-x',run:()=>{const f=fs['/etc/ssh/sshd_config'],v={};(f?f.c:'').split('\n').forEach(l=>{const t=l.trim(),m=t.match(/^(\w+)\s+(\S+)/);if(m&&t[0]!=='#')v[m[1].toLowerCase()]=m[2].toLowerCase()});let ok=true;const o=[['permitrootlogin','Root login disabled'],['passwordauthentication','Password logins disabled (keys only)'],['permitemptypasswords','Empty passwords rejected']].map(([k,t])=>{const g=v[k]==='no';if(!g)ok=false;return (g?'✔ ':'✘ ')+t+(g?'':' (now: '+(v[k]||'unset')+')')});if(ok){win();o.push('✔ sshd hardened')}return o.join('\n')}}},hints:['Run ./ssh-audit.sh and compare each failing line with the config.','Three directives need the value no.','PermitRootLogin no, PasswordAuthentication no, PermitEmptyPasswords no (then Save)'],why:'Root login and password logins are what brute-force bots attack. Setting them to no forces key-based login for normal users, and rejecting empty passwords closes the easiest hole.'},
{id:'leak',cat:'Secrets',title:'Leaked cloud key',xp:80,edit:['app/config.js'],story:'Your repo in ~/app contains secrets. Find them with grep -r, remove the key from the code, and make sure .env is never committed. Verify with ./scan.sh inside app.',files:{'app/config.js':{c:'// app config\nconst AWS_KEY = "AKIAIOSFODNN7EXAMPLE";\nmodule.exports = { region: "ap-south-1", key: AWS_KEY };\n'},'app/.env':{c:'DB_PASS=hunter2\n'},'app/scan.sh':{c:'#!/bin/sh\n',m:'rwxr-xr-x',run:()=>{const A=HOME+'/app',o1=!Object.keys(fs).some(k=>k.startsWith(A+'/')&&!fs[k].d&&/AKIA[0-9A-Z]{16}/.test(fs[k].c)),g=fs[A+'/.gitignore'],o2=!!g&&/^\.env$/m.test(g.c),o=[(o1?'✔':'✘')+' no cloud keys in source files',(o2?'✔':'✘')+' .env is listed in .gitignore'];if(o1&&o2){win();o.push('✔ repo is clean')}else o.push('✘ secret scan failed');return o.join('\n')}}},hints:['cd app, then grep -r KEY . and grep -ri pass .','Replace the literal key in config.js with process.env.AWS_KEY, and Save.','echo .env > .gitignore then ./scan.sh'],why:'Anything committed to git stays in history, so keys must live in environment variables, never in source. .gitignore keeps local secret files like .env out of the repo. (A leaked real key must also be rotated.)'},
{id:'brute',cat:'Incident',title:'Brute-force attack',xp:100,edit:[],story:'Someone is hammering SSH. Read /var/log/auth.log, find the IP with the most failed logins, and block it with the firewall. Do not block your admin (10.0.0.5).',files:{'/var/log/auth.log':{c:AUTHLOG}},check:()=>(S.fw||[]).includes('203.0.113.9')&&!(S.fw||[]).includes('10.0.0.5'),hints:['grep Failed /var/log/auth.log shows the failed attempts.',"Count per IP: grep Failed /var/log/auth.log | awk '{print $11}' | sort | uniq -c | sort -rn",'sudo ufw deny from <the top IP>'],why:'Counting failed logins per source IP exposes the attacker (203.0.113.9 had 14 attempts). A firewall deny rule drops its traffic before SSH sees it. Always double check you are not blocking your own admin address.'},
{id:'miner',cat:'Incident',title:'Rogue process',xp:80,edit:[],story:'The server is crawling and the fans scream. Find the process eating the CPU, stop it, and delete the file it runs from so it cannot return.',files:{'/tmp/.kswapd0':{c:'#!/bin/sh\n# not a real kernel thread\n',m:'rwxr-xr-x'}},procs:[{pid:666,u:'www-data',c:'98.7',cmd:'/tmp/.kswapd0 --pool xmr.evil.example'},{pid:731,u:'dojo',c:'0.0',cmd:'sleep 3000'}],check:()=>!S.procs.some(p=>p.pid===666)&&!fs['/tmp/.kswapd0'],hints:['ps aux and look at the CPU column and the command.','A hidden file in /tmp is running. ls -la /tmp','kill -9 666 and rm /tmp/.kswapd0'],why:'ps aux exposed one process at 98% CPU running a hidden file in /tmp, a classic malware spot. Killing the process stops it, and deleting the file stops a restart. In real life you would also find out how it got in.'},
{id:'dockerfile',cat:'DevSecOps',title:'Harden the Dockerfile',xp:100,edit:['Dockerfile'],story:'Your image works, but the security review is red: a secret baked into a layer, a root user, SSH exposed and a floating base tag. Run hadolint Dockerfile, fix every finding in the editor, save, and lint again.',files:{'Dockerfile':{c:'FROM node:latest\nWORKDIR /app\nENV DB_PASSWORD=hunter2\nCOPY . .\nRUN npm ci\nEXPOSE 22 3000\nCMD ["node","server.js"]\n'}},hints:['Run hadolint Dockerfile and fix the findings one by one.','Secrets must never live in ENV/ARG (they stay in image layers). Pin the base tag, expose only 3000, and add a non-root USER.','FROM node:20-alpine, delete the ENV line, RUN adduser -D app, USER app, EXPOSE 3000'],why:'ENV/ARG secrets are readable by anyone who pulls the image, so they are passed at runtime instead. A container running as root makes any escape far worse, an exposed port 22 invites attacks, and :latest changes under you, so pin an exact tag.'},
{id:'trivy',cat:'DevSecOps',title:'Read the Trivy report',xp:80,edit:['Dockerfile'],story:'CI blocked your release because of a scary Trivy scan. Run trivy image . , read the Fixed Version column, and fix the image so it passes.',files:{'Dockerfile':{c:'FROM node:14\nWORKDIR /app\nCOPY . .\nRUN npm ci\nUSER node\nEXPOSE 3000\nCMD ["node","server.js"]\n'}},hints:['Run trivy image . and look at Severity and Fixed Version.','Most findings come from the old base image, not your code.','Change the first line to FROM node:20-alpine, save, and scan again'],why:'Scanners list which package is vulnerable and which version fixes it. Here almost everything came from an end-of-life base image, so moving to a maintained tag (node:20-alpine) cleared all HIGH and CRITICAL findings at once.'},
{id:'deps',cat:'DevSecOps',title:'Vulnerable dependencies',xp:80,edit:['package.json'],story:'npm audit is failing in CI. Run npm audit, read which version fixes each package, update package.json in the editor, save, and audit again.',files:{'package.json':{c:'{\n  "name": "shop",\n  "dependencies": {\n    "express": "^4.21.0",\n    "lodash": "4.17.15",\n    "minimist": "~1.2.0"\n  }\n}\n'}},hints:['npm audit lists each package and the version that fixes it.','Raise lodash and minimist to at least the fixed versions.','"lodash": "^4.17.21" and "minimist": "^1.2.8", then npm audit'],why:'Old dependency versions carry known vulnerabilities (lodash command injection, minimist prototype pollution). The audit report names the first safe version; upgrading to it or newer removes the risk without touching your own code.'},
{id:'iam',cat:'DevSecOps',title:'Over-powered IAM policy',xp:100,edit:['policy.json'],story:'The image-resizer service only needs to read files from the bucket dojo-assets, but its policy hands it the whole cloud. Fix policy.json, save, then run ./audit-iam.sh.',files:{'policy.json':{c:'{\n  "Version": "2012-10-17",\n  "Statement": [\n    { "Effect": "Allow", "Action": "*", "Resource": "*" }\n  ]\n}\n'},'audit-iam.sh':{c:'#!/bin/sh\n',m:'rwxr-xr-x',run:()=>{let p;try{p=JSON.parse(fs[HOME+'/policy.json'].c)}catch(e){return '✘ policy.json is not valid JSON'}const A=new Set(),R=new Set(),bad=[];[].concat(p.Statement||[]).forEach(st=>{if(st.Effect!=='Allow')return;[].concat(st.Action||[]).forEach(x=>{A.add(x);if(x==='*'||/:\*$/.test(x))bad.push('wildcard action '+x)});[].concat(st.Resource||[]).forEach(x=>{R.add(x);if(x==='*')bad.push('wildcard resource *')})});const okA=A.has('s3:GetObject')&&[...A].every(x=>['s3:GetObject','s3:ListBucket'].includes(x)),okR=R.size>0&&[...R].every(x=>['arn:aws:s3:::dojo-assets','arn:aws:s3:::dojo-assets/*'].includes(x)),o=[bad.length?'✘ too broad: '+[...new Set(bad)].join(', '):'✔ no wildcards',okA?'✔ only the needed s3 read actions':'✘ allow only s3:GetObject (and optionally s3:ListBucket)',okR?'✔ scoped to the dojo-assets bucket':'✘ resource must be the dojo-assets bucket, not everything'];if(!bad.length&&okA&&okR){win();o.push('✔ least privilege achieved')}return o.join('\n')}}},hints:['Run ./audit-iam.sh and read what is too broad.','Least privilege: only the needed action, only the needed resource, no *.','Action ["s3:GetObject"], Resource "arn:aws:s3:::dojo-assets/*"'],why:'A wildcard policy means one leaked key controls everything. Least privilege grants only the actions a service really uses (read objects) on only the resources it needs (one bucket), which limits the damage of any compromise.'},
{id:'sqli',cat:'DevSecOps',title:'SQL injection',xp:100,edit:['login.js'],story:'A pentester logged in as admin using the name \' OR \'1\'=\'1. The login query glues user input into SQL. Fix login.js, save, and run ./sqltest.sh.',files:{'login.js':{c:'// login handler\nfunction login(db, name, pass) {\n  const sql = "SELECT * FROM users WHERE name = \'" + name + "\' AND pass = \'" + pass + "\'";\n  return db.query(sql);\n}\n'},'sqltest.sh':{c:'#!/bin/sh\n',m:'rwxr-xr-x',run:()=>{const c=(fs[HOME+'/login.js']||{c:''}).c,glued=/['"]\s*\+\s*(name|pass)\b|\b(name|pass)\s*\+\s*['"]|\$\{\s*(name|pass)/.test(c),param=/SELECT[^;\n]*(\?|\$1)/.test(c)&&/\[\s*(name|pass)/.test(c),pl="' OR '1'='1";if(glued||!param)return 'payload: '+pl+'\n✘ input is glued into the SQL: the payload changes the query (injection works) and returns ALL users'+(glued?'':'\n✘ no placeholders found (use ? and pass [name, pass])');win();return 'payload: '+pl+'\n✔ payload is treated as plain text, 0 rows returned\n✔ query uses placeholders'}}},hints:['Never build SQL by joining strings with user input.','Use placeholders (?) in the query and pass the values separately.','const sql = "SELECT * FROM users WHERE name = ? AND pass = ?"; return db.query(sql, [name, pass]);'],why:'When input is concatenated into SQL, an attacker can change the meaning of the query. With placeholders the database receives the query and the values separately, so the payload is only ever data and never code.'},
{id:'ports',cat:'DevSecOps',title:'Close the open ports',xp:80,edit:[],story:'A scan found your server exposing more than it should. Run ss -tlnp, decide what must stay public (SSH 22, web 80), and block the databases (3306 MySQL, 6379 Redis) with the firewall.',files:{},check:()=>{const p=S.fwp||[];return p.includes('3306')&&p.includes('6379')&&!p.includes('22')&&!p.includes('80')},hints:['ss -tlnp lists listening services. Which ones are databases?','ufw deny <port> blocks a port. Do not block 22 or 80.','sudo ufw deny 3306 and sudo ufw deny 6379'],why:'Databases and caches are meant for your app, not the internet. Exposed MySQL and Redis ports are scanned within minutes of going online. Blocking them while keeping SSH and web reachable shrinks the attack surface.'}
];
/* ---------- virtual filesystem + shell ---------- */
const dirname=k=>k.replace(/\/[^/]*$/,'')||'/',kids=p=>Object.keys(fs).filter(k=>k!==p&&dirname(k)===p);
const res=p=>{p=p||'.';if(p[0]!=='/')p=S.cwd+'/'+p;const o=[];for(const s of p.split('/')){if(!s||s==='.')continue;s==='..'?o.pop():o.push(s)}return '/'+o.join('/')};
function mkfs(x){const f={};const d=p=>{if(!f[p]){f[p]={d:1,m:'rwxr-xr-x'};if(p!=='/')d(dirname(p))}};d('/');
const base={'/home/dojo/notes.txt':{c:'welcome to the dojo\nlinux is fun\npractice every day\n'},'/etc/hostname':{c:'dojo\n'},'/var/log/syslog':{c:'boot ok\nnginx started\nerror: disk 91%\nsshd listening\n'},'/tmp/.keep':{c:''}};
const all={...base};for(const k in x)all[k[0]==='/'?k:HOME+'/'+k]=x[k];
for(const k in all){d(dirname(k));f[k]={m:'rw-r--r--',...all[k]}}return f}
const C={
help:()=>'Try: ls cd pwd cat echo mkdir touch rm cp mv chmod grep(-r -i -n -v) head tail wc sort uniq awk env export whoami id ps(aux) kill ssh ufw ss hadolint trivy npm(audit) curl history clear nano sudo\nexplain [error text] asks Sensei to explain an error. Supports pipes (|), > and >>, $VARS, ~ and Tab completion.',
pwd:()=>S.cwd,whoami:()=>'dojo',id:()=>'uid=1000(dojo) gid=1000(dojo) groups=1000(dojo),27(sudo),998(docker)',hostname:()=>'dojo',
uname:()=>'Linux dojo 6.8.0-dojo x86_64 GNU/Linux',date:()=>new Date().toString(),echo:a=>a.join(' '),
df:()=>'Filesystem  Size  Used Avail Use% Mounted on\n/dev/vda1    20G  9.1G  11G  46% /',free:()=>'        total  used  free\nMem:     2048M  612M  1130M',
ps:a=>/[ae]/.test(a.join(''))?'USER       PID %CPU COMMAND\n'+S.procs.map(p=>p.u.padEnd(10)+' '+String(p.pid).padStart(4)+' '+p.c.padStart(5)+' '+p.cmd).join('\n'):'  PID TTY      TIME CMD\n   88 pts/0 00:00:00 bash\n  131 pts/0 00:00:00 ps',
kill:a=>{const n=+a.filter(x=>x[0]!=='-').pop();if(!n)return 'kill: usage: kill [-9] pid';if([1,42,88].includes(n))return `kill: (${n}) - Operation not permitted`;const i=S.procs.findIndex(p=>p.pid===n);if(i<0)return `kill: (${n}) - No such process`;S.procs.splice(i,1);return ''},
systemctl:a=>a[0]==='status'?'● '+(a[1]||'nginx')+'.service - active (running) since boot':'systemctl: try "status nginx"',
history:()=>S.hist.map((h,i)=>String(i+1).padStart(4)+'  '+h).join('\n'),
clear:()=>{S.O.innerHTML='';return ''},
ls(a){const fl=a.filter(x=>x[0]=='-').join(''),ps=a.filter(x=>x[0]!='-'),p=res(ps[0]),f=fs[p];if(!f)return `ls: cannot access '${ps[0]}': No such file or directory`;
const L=/l/.test(fl),names=f.d?kids(p).map(k=>k.split('/').pop()).filter(n=>/a/.test(fl)||n[0]!='.').sort():[p.split('/').pop()];
return names.map(n=>{const e=f.d?fs[(p==='/'?'':p)+'/'+n]:f;return L?`${e.d?'d':'-'}${e.m} 1 dojo dojo ${String((e.c||'').length).padStart(5)} ${n}`:n}).join(L?'\n':'  ')},
cd(a){const t=res(a[0]||HOME);return !fs[t]?`bash: cd: ${a[0]}: No such file or directory`:!fs[t].d?`bash: cd: ${a[0]}: Not a directory`:(S.cwd=t,'')},
cat(a,inp){if(!a.length)return inp||'';return a.map(x=>{const f=fs[res(x)];return !f?`cat: ${x}: No such file or directory`:f.d?`cat: ${x}: Is a directory`:f.c.replace(/\n$/,'')}).join('\n')},
mkdir(a){const P=a.includes('-p');return a.filter(x=>x[0]!='-').map(x=>{const t=res(x);if(fs[t])return P?'':`mkdir: cannot create directory '${x}': File exists`;if(!fs[dirname(t)]){if(!P)return `mkdir: cannot create directory '${x}': No such file or directory`;let q='';for(const s of t.split('/').filter(Boolean)){q+='/'+s;if(!fs[q])fs[q]={d:1,m:'rwxr-xr-x'}}return ''}fs[t]={d:1,m:'rwxr-xr-x'};return ''}).filter(Boolean).join('\n')},
touch(a){return a.map(x=>{const t=res(x);if(!fs[dirname(t)])return `touch: cannot touch '${x}': No such file or directory`;if(!fs[t])fs[t]={c:'',m:'rw-r--r--'};return ''}).filter(Boolean).join('\n')},
rm(a){const r=a.some(x=>/^-\w*r/.test(x)),o=[];for(const x of a.filter(x=>x[0]!='-')){const p=res(x),f=fs[p];if(p==='/'){o.push("rm: it is dangerous to operate recursively on '/'");continue}if(!f){o.push(`rm: cannot remove '${x}': No such file or directory`);continue}if(f.d&&!r){o.push(`rm: cannot remove '${x}': Is a directory`);continue}Object.keys(fs).forEach(k=>{if(k===p||k.startsWith(p+'/'))delete fs[k]})}return o.join('\n')},
cp(a){const[s,d]=a.filter(x=>x[0]!='-'),f=fs[res(s||'')];if(!f||f.d||!d)return 'cp: cannot copy (need an existing file and a target)';let t=res(d);if(fs[t]&&fs[t].d)t+='/'+res(s).split('/').pop();fs[t]={...f};return ''},
mv(a){const e=C.cp(a);if(e)return e.replace('cp','mv');delete fs[res(a.filter(x=>x[0]!='-')[0])];return ''},
chmod(a){const m=a[0],f=fs[res(a[1])];if(!a[1])return 'chmod: missing operand';if(!f)return `chmod: cannot access '${a[1]}': No such file or directory`;
if(/^[0-7]{3}$/.test(m))f.m=[...m].map(d=>[4,2,1].map((b,i)=>d&b?'rwx'[i]:'-').join('')).join('');
else{const r=m.match(/^([ugoa]*)([+-])([rwx]+)$/);if(!r)return `chmod: invalid mode: '${m}'`;const w=r[1]||'a',s=[...f.m];[...'ugo'].forEach((x,i)=>{if(w.includes('a')||w.includes(x))for(const c of r[3])s[i*3+'rwx'.indexOf(c)]=r[2]=='+'?c:'-'});f.m=s.join('')}return ''},
grep(a,inp){const fl=a.filter(x=>x[0]=='-').join(''),r=a.filter(x=>x[0]!='-');if(!r[0])return 'usage: grep [-inrv] pattern [file]';let re;try{re=new RegExp(r[0],/i/.test(fl)?'i':'')}catch(e){return 'grep: invalid pattern'}const hit=(l,i)=>l!==''&&re.test(l)!=/v/.test(fl)?(/n/.test(fl)?i+':':'')+l:null;
if(/r/.test(fl)){const t=r[1]||'.',p=res(t);if(!fs[p])return `grep: ${t}: No such file or directory`;return Object.keys(fs).filter(k=>!fs[k].d&&(k===p||k.startsWith(p+'/'))).sort().flatMap(k=>fs[k].c.split('\n').map((l,i)=>hit(l,i+1)).filter(x=>x!==null).map(x=>(k===p?t:t.replace(/\/$/,'')+k.slice(p.length))+':'+x)).join('\n')}
let tx=inp;if(r[1]){const f=fs[res(r[1])];if(!f)return `grep: ${r[1]}: No such file or directory`;tx=f.c}if(tx==null)return '';return tx.split('\n').map((l,i)=>hit(l,i+1)).filter(x=>x!==null).join('\n')},
wc(a,inp){const x=a.filter(v=>v[0]!='-')[0],tx=x?(fs[res(x)]||{c:''}).c:inp||'',l=tx.split('\n').length-(tx.endsWith('\n')||!tx?1:0);return a.includes('-l')?String(l):`${l} ${tx.split(/\s+/).filter(Boolean).length} ${tx.length}`},
head(a,i){return ht('head',a,i)},tail(a,i){return ht('tail',a,i)},
env:()=>Object.entries(S.env).map(([k,v])=>k+'='+v).join('\n'),
export(a){a.forEach(x=>{const i=x.indexOf('=');if(i>0)S.env[x.slice(0,i)]=x.slice(i+1)});return ''},
curl(a){const u=a.find(x=>x[0]!='-')||'',m=u.match(/(?:localhost|127\.0\.0\.1)(?::(\d+))?/);if(!m)return `curl: (6) Could not resolve host: ${u}`;const p=m[1]||'80';return S.ch&&S.ch.curl?S.ch.curl(p):`curl: (7) Failed to connect to localhost port ${p}: Connection refused`},
nano(a){if(!a[0])return 'usage: nano FILE';const p=res(a[0]);if(!fs[dirname(p)])return `nano: cannot open ${a[0]}: No such directory`;if(!fs[p])fs[p]={c:'',m:'rw-r--r--'};S.edit(p);return 'Opened '+a[0]+' in the editor panel. Save with the button or Ctrl+S.'},
ssh(a){const i=a.indexOf('-i'),key=i>-1?a[i+1]:null,host=a.filter(x=>x[0]!=='-'&&x!==key).pop();if(!host)return 'usage: ssh [-i key] host';const k=key?res(key):HOME+'/.ssh/id_rsa',f=fs[k];
if(!f||f.d)return `Warning: Identity file ${key||k} not accessible: No such file or directory.\n${host}: Permission denied (publickey).`;
if(f.m.slice(3)!=='------')return `@@@ WARNING: UNPROTECTED PRIVATE KEY FILE! @@@\nPermissions 0${[0,3,6].map(j=>[...f.m.slice(j,j+3)].reduce((n,c,x)=>n+(c==='-'?0:[4,2,1][x]),0)).join('')} for '${k}' are too open.\nThis private key will be ignored.\n${host}: Permission denied (publickey).`;
if(S.ch&&S.ch.id==='sshkey')win();return `✔ Connected to ${host} as deploy`},
ufw(a){const r=S.fw||(S.fw=[]),pt=S.fwp||(S.fwp=[]);if(a[0]==='status')return 'Status: active\n\nTo          Action   From\n22/tcp      ALLOW    Anywhere'+r.map(x=>`\nAnywhere    DENY     ${x}`).join('')+pt.map(x=>'\n'+(x+'/tcp').padEnd(12)+'DENY     Anywhere').join('');
if(a[0]==='deny'&&/^\d{1,5}(\/tcp)?$/.test(a[1]||'')){const p=a[1].replace('/tcp','');if(!pt.includes(p))pt.push(p);return +p===22||+p===80?'Rule added\n✘ Warning: this blocks SSH/web. You may lock yourself out!':'Rule added'}
if(a[0]==='deny'&&a[1]==='from'&&/^\d{1,3}(\.\d{1,3}){3}$/.test(a[2]||'')){if(!r.includes(a[2]))r.push(a[2]);return a[2]==='10.0.0.5'?'Rule added\n✘ Warning: 10.0.0.5 is your admin workstation. You just locked yourself out!':'Rule added'}
return 'usage: ufw status | ufw deny <port> | ufw deny from <ip>'},
ss:()=>'State   Local Address:Port   Process\nLISTEN  0.0.0.0:22           sshd\nLISTEN  0.0.0.0:80           nginx\nLISTEN  0.0.0.0:3306         mysqld\nLISTEN  0.0.0.0:6379         redis-server',
hadolint(a){const f=fs[res(a[0]||'Dockerfile')];if(!f||f.d)return 'hadolint: Dockerfile not found';const c=f.c,o=[];
if(/^\s*(ENV|ARG)\s+\w*(PASS|SECRET|TOKEN|KEY)\w*[\s=]/mi.test(c))o.push('✘ DL-SEC1 secret stored in ENV/ARG: it stays in the image layers, pass it at runtime');
if(!/^USER\s+(?!root\b|0\b)\S+/m.test(c))o.push('✘ DL3002 container runs as root: add a non-root USER');
if(/^EXPOSE\b.*\b22\b/m.test(c))o.push('✘ DL-SEC2 EXPOSE 22 opens SSH inside the container');
if(/^FROM\s+\S+:latest\b/m.test(c)||/^FROM\s+[^:\s]+\s*$/m.test(c))o.push('✘ DL3007 base image is not pinned: use an exact tag');
if(!o.length){if(S.ch&&S.ch.id==='dockerfile')win();return '✔ no findings'}return o.join('\n')+'\n'+o.length+' finding(s)'},
trivy(){const f=fs[HOME+'/Dockerfile'];if(!f)return 'trivy: no Dockerfile in the home folder';const m=f.c.match(/^FROM\s+(\S+)/m);if(!m)return 'trivy: no FROM line found';const mv=m[1].match(/node:(\d+)/),head='Training data: the CVE ids below are fictional.\n\n'+m[1]+'\n';
if(!mv||+mv[1]<18)return head+'Library   Vulnerability   Severity  Installed  Fixed Version\nopenssl   CVE-2099-1001   CRITICAL  1.1.1k     3.0.13 (node:20 base)\nglibc     CVE-2099-1002   CRITICAL  2.28       2.36 (node:20 base)\nnpm       CVE-2099-1003   HIGH      6.14.0     10.2.4 (node:20 base)\nzlib      CVE-2099-1004   MEDIUM    1.2.11     1.3.1\nTotal: 4 (MEDIUM: 1, HIGH: 1, CRITICAL: 2)\nTip: the Fixed Version column points to the node:20 base image.';
if(S.ch&&S.ch.id==='trivy')win();return head+'Total: 0 (HIGH: 0, CRITICAL: 0)\n✔ image passes the policy'},
npm(a){if(a[0]!=='audit')return "npm: only 'npm audit' is available in the dojo";if(a[1]==='fix')return 'npm audit fix is disabled here. Edit package.json yourself, that is the lesson.';const f=fs[S.cwd+'/package.json'];if(!f)return 'npm ERR! code ENOENT\nnpm ERR! no package.json in '+S.cwd+' (cd into the project folder)';let p;try{p=JSON.parse(f.c)}catch(e){return 'npm ERR! code EJSONPARSE\nnpm ERR! package.json is not valid JSON'}
const d={...p.dependencies},v=x=>String(x).replace(/^[^\d]*/,'').split('.').map(n=>parseInt(n)||0),lt=(x,y)=>{const A=v(x),B=v(y);for(let i=0;i<3;i++)if((A[i]||0)!==(B[i]||0))return (A[i]||0)<(B[i]||0);return false},R=[['lodash','4.17.21','high','Command Injection (CVE-2021-23337)'],['minimist','1.2.6','critical','Prototype Pollution (CVE-2021-44906)']].filter(([n,fx])=>d[n]&&lt(d[n],fx));
if(!R.length){if(S.ch&&S.ch.id==='deps')win();return 'found 0 vulnerabilities'}
return '# npm audit report\n\n'+R.map(([n,fx,sev,t])=>`${n}  <${fx}\nSeverity: ${sev}\n${t}\nfix available: upgrade ${n} to >=${fx}\n`).join('\n')+`\n${R.length} vulnerabilit${R.length>1?'ies':'y'}`},
sort(a,inp){const fl=a.filter(x=>x[0]==='-').join(''),f=a.find(x=>x[0]!=='-'),tx=f?(fs[res(f)]||{c:''}).c:inp||'',n=/n/.test(fl),L=tx.split('\n').filter(Boolean).sort((x,y)=>(n?parseFloat(x)-parseFloat(y):0)||(x<y?-1:x>y?1:0));if(/r/.test(fl))L.reverse();return L.join('\n')},
uniq(a,inp){const o=[];for(const l of (inp||'').split('\n').filter(Boolean)){if(o.length&&o[o.length-1][1]===l)o[o.length-1][0]++;else o.push([1,l])}return o.map(([c,l])=>a.includes('-c')?String(c).padStart(7)+' '+l:l).join('\n')},
awk(a,inp){const q=a.filter(x=>x[0]!=='-'),m=(q[0]||'').match(/^\{\s*print\s*(.*?)\s*\}$/);if(!m)return "awk: only '{print $N}' is supported here";const tx=q[1]?(fs[res(q[1])]||{c:''}).c:inp||'',cols=(m[1]||'$0').split(/\s*,\s*/);return tx.split('\n').filter(Boolean).map(l=>{const w=l.trim().split(/\s+/);return cols.map(t=>t==='$0'?l:/^\$\d+$/.test(t)?w[+t.slice(1)-1]||'':t).join(' ')}).join('\n')}
};
C.vi=C.vim=C.nano;
function ht(k,a,inp){let n=10,fl=[];for(let i=0;i<a.length;i++){if(a[i]==='-n')n=+a[++i];else if(/^-\d+$/.test(a[i]))n=-a[i];else fl.push(a[i])}const f=fl[0]?fs[res(fl[0])]:null,tx=fl[0]?(f&&f.c):inp;if(tx==null)return `${k}: ${fl[0]}: No such file or directory`;const L=tx.replace(/\n$/,'').split('\n');return (k=='head'?L.slice(0,n):L.slice(-n)).join('\n')}
function tok(s){return (s.match(/"[^"]*"|'[^']*'|\S+/g)||[]).map(x=>{const sq=x[0]=="'",v=/^["']/.test(x)?x.slice(1,-1):x;return sq?v:v.replace(/\$(\w+)/g,(_,k)=>S.env[k]??'').replace(/^~(?=\/|$)/,HOME)})}
function one(s,inp){let t=tok(s.replace(/\s*(>>?)\s*/g,' $1 ').trim());if(!t.length)return '';let red=null;const ri=t.findIndex(x=>x==='>'||x==='>>');if(ri>-1){red=[t[ri],t[ri+1]];t=t.slice(0,ri)}
let c=t[0],a=t.slice(1);if(c==='sudo'){c=a[0];a=a.slice(1)}let o;
if(!c)o='sudo: a command is required';
else if(c.includes('/')){const p=res(c),f=fs[p];o=!f?`bash: ${c}: No such file or directory`:f.d?`bash: ${c}: Is a directory`:!/x/.test(f.m)?`bash: ${c}: Permission denied`:f.run?f.run():'(script ran, no output)'}
else if(C.hasOwnProperty(c))o=C[c](a,inp);else o=`bash: ${c}: command not found`;
if(red){if(!red[1])return 'bash: syntax error near unexpected token `newline`';const p=res(red[1]);if(!fs[dirname(p)])return `bash: ${red[1]}: No such file or directory`;if(fs[p]&&fs[p].d)return `bash: ${red[1]}: Is a directory`;fs[p]={m:'rw-r--r--',...fs[p],c:(red[0]=='>>'&&fs[p]?fs[p].c:'')+o+'\n'};return ''}return o}
const run=line=>{let o=null;for(const sg of line.split(/\s\|\s/))o=one(sg,o);if(S.ch&&S.ch.check&&!S.won&&S.ch.check())win();return o};
/* ---------- shell UI ---------- */
const col=l=>/error|denied|failed|not found|no such|✘|crashloop|refused|invalid|emerg|bad gateway|unable|cannot|not set/i.test(l)?'e':/✔|success|passed|started|running|ok$/i.test(l)?'o':'';
function boot(ch){S={fs:mkfs(ch?ch.files:{}),cwd:HOME,env:{HOME,USER:'dojo',SHELL:'/bin/bash',PATH:'/usr/local/bin:/usr/bin:/bin',LANG:'en_US.UTF-8'},hist:[],ch,flags:{},procs:[{pid:1,u:'root',c:'0.0',cmd:'/sbin/init'},{pid:42,u:'root',c:'0.1',cmd:'sshd: /usr/sbin/sshd -D'},{pid:88,u:'dojo',c:'0.0',cmd:'-bash'},...((ch&&ch.procs)||[]).map(p=>({...p}))],won:0,O:$('#O')};fs=S.fs;
const I=$('#I'),P=$('#P'),O=S.O;let hi=0;
const pr=()=>P.textContent='dojo@dojo:'+S.cwd.replace(HOME,'~')+'$',put=(t,c)=>{String(t).split('\n').forEach(l=>{const d=document.createElement('div');d.className=c||col(l);d.textContent=l||' ';O.appendChild(d)});O.scrollTop=1e9};
put(ch?'Debug Dojo shell - type "help" for commands. Read the story, then fix the bug.':'Linux Lab - a safe sandbox. Type "help". Nothing here can break your machine.','o');pr();
S.edit=openEd;
$('#T').onclick=()=>getSelection().toString()||I.focus();
I.onkeydown=e=>{if(e.key==='Enter'){const v=I.value;put('dojo@dojo:'+S.cwd.replace(HOME,'~')+'$ '+v,'pr');I.value='';if(v.trim()){S.hist.push(v);hi=S.hist.length;if(/^explain\b/.test(v))explain(v.replace(/^explain\s*/,'')||S.last||'',put);else{let o;try{o=run(v)}catch(x){o='shell error: '+x.message}if(o){put(o);S.last=o}}}pr()}
else if(e.key==='ArrowUp'){e.preventDefault();if(hi>0)I.value=S.hist[--hi]}
else if(e.key==='ArrowDown'){e.preventDefault();I.value=hi<S.hist.length-1?S.hist[++hi]:(hi=S.hist.length,'')}
else if(e.key==='l'&&e.ctrlKey){e.preventDefault();O.innerHTML=''}
else if(e.key==='c'&&e.ctrlKey){put(P.textContent+' '+I.value+'^C','pr');I.value=''}
else if(e.key==='Tab'){e.preventDefault();const v=I.value,pt=v.split(/\s+/),last=pt.pop(),i=last.lastIndexOf('/')+1,base=last.slice(i),first=!pt.length&&!i;
const pool=first?Object.keys(C):kids(res(last.slice(0,i)||'.')).map(k=>k.split('/').pop()),m=pool.filter(x=>x.startsWith(base));
if(m.length===1)I.value=[...pt,last.slice(0,i)+m[0]].join(' ')+(first?' ':'');else if(m.length>1)put(m.join('  '),'m')}};
setTimeout(()=>I.focus({preventScroll:true}),50);
const tabs=[];let cur=null;
function openEd(p){$('#ed').hidden=false;if(!tabs.includes(p))tabs.push(p);cur=p;draw()}
function draw(){$('#tabs').innerHTML=tabs.map(p=>`<button role="tab" aria-selected="${p===cur}" data-p="${p}">${p.split('/').pop()}</button>`).join('');$('#ta').value=(fs[cur]||{c:''}).c;$('#es').textContent=cur;
$('#tabs').querySelectorAll('button').forEach(b=>b.onclick=()=>{cur=b.dataset.p;draw()})}
const sv=()=>{if(!cur)return;fs[cur]={m:'rw-r--r--',...fs[cur],c:$('#ta').value};$('#es').textContent='Saved '+cur+' ✔';put('Saved '+cur,'o');if(S.ch&&S.ch.check&&!S.won&&S.ch.check())win()};
$('#sv').onclick=sv;$('#ta').onkeydown=e=>{if((e.ctrlKey||e.metaKey)&&e.key==='s'){e.preventDefault();sv()}};
if(ch&&ch.edit.length){const E=ch.edit.map(p=>p[0]==='/'?p:HOME+'/'+p);E.forEach(openEd);cur=E[0];draw()}}
const termHTML=`<div class="term" id="T"><div class="tb"><i></i><i></i><i></i><span style="margin-left:8px">bash - dojo@dojo</span></div><div class="out" id="O" role="log" aria-live="polite"></div><div class="in"><span id="P"></span><input id="I" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Terminal input"></div></div>`;
const edHTML=`<div class="card" id="ed" hidden style="padding:12px;margin-top:14px"><div class="tabs" id="tabs" role="tablist"></div><textarea id="ta" aria-label="File editor" spellcheck="false"></textarea><div style="display:flex;justify-content:space-between;align-items:center;margin-top:8px"><span class="mono" id="es" style="font-size:12px;color:var(--m)"></span><button class="btn" id="sv">Save (Ctrl+S)</button></div></div>`;
/* ---------- views ---------- */
let USER=null;
const recalc=()=>{SV.xp=Object.entries(SV.done).reduce((a,[id,d])=>{const c=CH.find(x=>x.id===id);return a+(c?Math.max(10,c.xp-d.h*10):0)},0)};
const sync=()=>USER?fetch('/api/progress',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({done:Object.fromEntries(Object.entries(SV.done).filter(([k])=>CH.some(c=>c.id===k)))})}).catch(()=>{}):0;
const setAu=()=>{const a=$('#au');a.textContent=USER?USER.username+' · Log out':'Log in';a.href=USER?'#dojo':'#login'};
async function pull(){try{const r=await fetch('/api/progress');if(!r.ok)return;const j=await r.json();for(const k in j.done||{})if(!SV.done[k])SV.done[k]=j.done[k];recalc();save();sync()}catch(e){}}
let SERVER=true;
async function init(){for(const k in SV.done)if(!CH.some(c=>c.id===k))delete SV.done[k];recalc();save();try{const r=await fetch('/api/auth/me');if(r.ok){USER=await r.json();setAu();await pull()}else if(r.status!==401)SERVER=false}catch(e){SERVER=false}}
$('#au').onclick=async e=>{if(!USER)return;e.preventDefault();await fetch('/api/auth/logout',{method:'POST'}).catch(()=>{});USER=null;setAu();location.hash==='#dojo'?route():location.hash='dojo'};
const app=$('#app');
function clearT(){clearInterval(TM)}
function lab(){app.innerHTML=`<div class="wrap"><div class="bar2"><a href="#dojo">← Dojo</a><b>Linux Lab</b></div><p style="color:var(--m);margin-top:0">A free sandbox with a mini Linux. Try: <code>mkdir -p proj/src</code>, <code>echo hi &gt; a.txt</code>, <code>cat notes.txt | grep linux</code>, <code>chmod 755 a.txt</code>, <code>ls -la</code>. Use <code>nano file</code> for the editor.</p><div class="grid"><div>${edHTML}</div>${termHTML}</div></div>`;boot(null)}
function login(){
if(USER){app.innerHTML=`<div class="wrap"><div class="card auth"><h2>Welcome back, ${USER.username}</h2><p style="color:var(--m)">Your progress syncs to your account.</p><a class="btn glow" href="#dojo">Go to dojo</a></div></div>`;return}
let mode='login';
app.innerHTML=`<div class="wrap"><div class="card auth"><div class="mono" style="color:var(--g)">$ dojo auth</div><h2>Join the dojo</h2><div class="seg" role="tablist"><button type="button" role="tab" id="t1" aria-selected="true">Log in</button><button type="button" role="tab" id="t2" aria-selected="false">Sign up</button></div>
<form id="af" novalidate><label>Username<input class="f" id="u" autocomplete="username" maxlength="16" autocapitalize="off" spellcheck="false"></label><label>Password<input class="f" id="pw" type="password" autocomplete="current-password" maxlength="72"></label><div id="ae" class="e" role="alert" style="min-height:24px"></div><button class="btn glow" id="as" style="width:100%">Log in</button></form>
<p style="color:var(--m);font-size:14px">Username: 3-16 lowercase letters, numbers or _. Password: 8+ characters.</p><a href="#dojo">Continue as guest</a></div></div>`;
const tab=m=>{mode=m;$('#t1').setAttribute('aria-selected',m==='login');$('#t2').setAttribute('aria-selected',m!=='login');$('#as').textContent=m==='login'?'Log in':'Create account';$('#pw').autocomplete=m==='login'?'current-password':'new-password';$('#ae').textContent=''};
$('#t1').onclick=()=>tab('login');$('#t2').onclick=()=>tab('signup');$('#u').focus();
$('#af').onsubmit=async e=>{e.preventDefault();const b=$('#as'),er=$('#ae');er.textContent='';b.disabled=true;
try{const r=await fetch('/api/auth/'+(mode==='login'?'login':'register'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:$('#u').value.trim().toLowerCase(),password:$('#pw').value})});let j={};try{j=await r.json()}catch(x){}
if(!r.ok){er.textContent=r.status===404?'No server here. Use guest mode, or run the full project with Docker.':(j.error||'Something went wrong');b.disabled=false;return}
USER=j;setAu();await pull();location.hash='lab'}catch(x){er.textContent='Cannot reach the server. Guest mode still works offline.';b.disabled=false}}}
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
let GEN=null;
const oct2m=d=>[...d].map(x=>[4,2,1].map((b,i)=>x&b?'rwx'[i]:'-').join('')).join('');
function toChallenge(j){const files={};j.files.forEach(f=>{files[f.path]={c:f.content,m:oct2m(f.mode)}});return {id:'gen',cat:'AI',title:esc(j.title),xp:10,edit:j.files.map(f=>f.path),story:esc(j.story),files,hints:j.hints,why:esc(j.why),check:()=>j.rules.every(r=>{const f=fs[HOME+'/'+r.path];return !!f&&(r.op==='contains'?f.c.includes(r.val):r.op==='notContains'?!f.c.includes(r.val):f.m===oct2m(r.val))})}}
function gen(){app.innerHTML='<div class="wrap"><div class="card auth"><h2>AI challenge lab</h2><p style="color:var(--m)">Type a topic (for example: cron job, sudo rules, weak passwords). Claude builds a broken setup for you to fix. Practice only, no XP.</p><label>Topic<input class="f" id="gt" maxlength="80"></label><div id="ge" class="e" role="alert" style="min-height:24px"></div><button class="btn glow" id="gb" style="width:100%">Generate</button></div></div>';$('#gt').focus();
$('#gb').onclick=async()=>{const b=$('#gb'),er=$('#ge');er.textContent='';b.disabled=true;b.textContent='Building...';try{const r=await fetch('/api/generate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({topic:$('#gt').value.trim()})});const j=await r.json().catch(()=>({}));if(!r.ok)throw new Error(r.status===401?'Log in first.':(j.error||'Could not generate.'));GEN=toChallenge(j);location.hash='ch-gen'}catch(e){er.textContent=e.message;b.disabled=false;b.textContent='Generate'}}}
async function explain(text,put){if(!text.trim()){put('Nothing to explain yet. Run a command first, or type: explain <error text>','m');return}put('Sensei is reading it...','m');
try{const r=await fetch('/api/explain',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text})});const j=await r.json().catch(()=>({}));put(r.ok?'Sensei'+(j.source==='claude'?' (AI)':'')+': '+j.answer:(r.status===401?'Log in to use explain.':(j.error||'Explain is unavailable.')),r.ok?'o':'e')}catch(e){put('Explain needs the Dojo server (npm start).','e')}}
function chat(ch,onFirst){const box=document.createElement('div');box.className='card chat';box.innerHTML='<b>Sensei chat</b> <small style="color:var(--m)">Sensei asks questions instead of handing you the answer. First message costs 10 XP, like a hint.</small><div id="cm" aria-live="polite"></div><div style="display:flex;gap:8px;margin-top:8px"><input class="f" id="ci" style="margin:0" placeholder="Tell Sensei what you tried..." maxlength="300" aria-label="Message to Sensei"><button class="btn" id="cs">Send</button></div>';$('#hs').after(box);const msgs=[];let first=true;
const add=(who,t)=>{const d=document.createElement('div');d.className='cmsg '+who;d.textContent=(who==='me'?'You: ':'Sensei: ')+t;$('#cm').appendChild(d);return d};
const send=async()=>{const i=$('#ci'),t=i.value.trim();if(!t)return;i.value='';add('me',t);msgs.push({role:'user',content:t});if(first){first=false;onFirst()}const w=add('ai','...');
try{const files={};(ch.edit||[]).forEach(e=>{const k=e[0]==='/'?e:HOME+'/'+e;if(fs[k])files[e]=fs[k].c});const r=await fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({challenge:ch.id,messages:msgs.slice(-8),history:S.hist.slice(-8),files})});const j=await r.json().catch(()=>({}));const a=r.ok?j.answer:(r.status===401?'Log in to chat with Sensei.':(j.error||'Sensei is unavailable.'));w.textContent='Sensei: '+a;if(r.ok)msgs.push({role:'assistant',content:a})}catch(e){w.textContent='Sensei is offline here. Use the Hint button.'}};
$('#cs').onclick=send;$('#ci').onkeydown=e=>{if(e.key==='Enter')send()}}
async function cert(){app.innerHTML='<div class="wrap"><h2>Your certificate</h2><p id="cs2" style="color:var(--m)">Checking your progress...</p><canvas id="cv" width="1200" height="850" style="display:none;max-width:100%;border:1px solid var(--l);border-radius:12px" aria-label="Certificate of completion"></canvas><p><button class="btn glow" id="cd" hidden>Download PNG</button></p></div>';
try{const r=await fetch('/api/certificate',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'});const j=await r.json().catch(()=>({}));if(!r.ok){$('#cs2').textContent=r.status===401?'Log in to get your certificate.':(j.error||'Certificate is not available yet.');return}
$('#cs2').textContent='Congratulations, '+j.name+'! Your certificate is ready.';try{await document.fonts.ready}catch(e){}drawCert($('#cv'),j);$('#cv').style.display='block';const b=$('#cd');b.hidden=false;
b.onclick=()=>$('#cv').toBlob(bl=>{const a=document.createElement('a');a.href=URL.createObjectURL(bl);a.download='debug-dojo-certificate-'+j.name+'.png';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),2000)})}catch(e){$('#cs2').textContent='Certificates need the Dojo server (run npm start).'}}
function drawCert(cv,j){const x=cv.getContext('2d'),W=cv.width,H=cv.height,bt=belt(j.xp),F="'Bricolage Grotesque',Arial,sans-serif";const g=x.createLinearGradient(0,0,W,H);g.addColorStop(0,'#070b10');g.addColorStop(1,'#0d1f2b');x.fillStyle=g;x.fillRect(0,0,W,H);
x.strokeStyle='#39ff88';x.lineWidth=6;x.strokeRect(30,30,W-60,H-60);x.strokeStyle='#27e0ff';x.lineWidth=2;x.strokeRect(46,46,W-92,H-92);x.textAlign='center';
x.fillStyle='#39ff88';x.font="700 22px 'JetBrains Mono',monospace";x.fillText('>_ DEBUG DOJO',W/2,120);x.fillStyle='#dbe7f0';x.font='700 58px '+F;x.fillText('Certificate of Completion',W/2,230);x.fillStyle='#8196a8';x.font='24px '+F;x.fillText('This certifies that',W/2,320);
let sz=84;x.fillStyle='#27e0ff';x.font='700 '+sz+'px '+F;while(x.measureText(j.name).width>W-200&&sz>30){sz-=4;x.font='700 '+sz+'px '+F}x.fillText(j.name,W/2,430);
x.fillStyle='#dbe7f0';x.font='28px '+F;x.fillText('has completed all '+j.total+' Linux and DevSecOps challenges',W/2,510);x.fillText('with '+j.xp+' XP and earned the '+bt[0]+' Belt.',W/2,556);x.fillStyle=bt[2];x.fillRect(W/2-120,590,240,16);
x.fillStyle='#8196a8';x.font="20px 'JetBrains Mono',monospace";x.fillText('Issued '+j.date+'  |  Certificate ID '+j.id,W/2,700);x.fillText('Verify: '+location.origin+'/api/verify/'+j.id,W/2,740)}
async function room(code){app.innerHTML=`<div class="wrap"><h2>Team rooms</h2><p style="color:var(--m)">Create a room for your class or team, share the code, and watch everyone's progress.</p><div id="rl" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px"></div><div class="top2"><div class="card"><label>New room name<input class="f" id="rn" maxlength="40"></label><button class="btn" id="rc">Create room</button></div><div class="card"><label>Join with code<input class="f" id="rj" maxlength="6" autocapitalize="characters"></label><button class="btn" id="rb">Join</button></div></div><div id="re" class="e" role="alert" style="min-height:24px"></div><div id="rt"></div></div>`;
const J=async(u,b)=>{const r=await fetch(u,b?{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)}:{});const j=await r.json().catch(()=>({}));if(!r.ok)throw new Error(j.error||'Request failed');return j},go=async f=>{$('#re').textContent='';try{await f()}catch(e){$('#re').textContent=e.message}};
go(async()=>{const L=await J('/api/rooms');$('#rl').innerHTML=L.map(x=>`<a class="btn" href="#room-${x.code}">${esc(x.name)} · ${x.code}</a>`).join('')||'<span style="color:var(--m)">No rooms yet.</span>'});
$('#rc').onclick=()=>go(async()=>{const j=await J('/api/rooms',{name:$('#rn').value.trim()});location.hash='room-'+j.code});$('#rb').onclick=()=>go(async()=>{const j=await J('/api/rooms/join',{code:$('#rj').value.trim()});location.hash='room-'+j.code});
if(code)go(async()=>{const j=await J('/api/rooms/'+encodeURIComponent(code));$('#rt').innerHTML=`<h3>${esc(j.name)} <span class="chip">${esc(j.code)}</span></h3><div class="card lb">${j.members.map((m,i)=>`<div><span>${i+1}. ${esc(m.user)}${m.user===j.owner?' (teacher)':''}</span><span class="mono">${m.solved}/${CH.length} · ${m.xp} XP</span></div>`).join('')}</div>`})}
function chal(id){const ch=CH.find(c=>c.id===id)||(id==='gen'&&GEN);if(!ch)return dojo();let hn=0;const rw=()=>Math.max(10,ch.xp-hn*10),t0=Date.now();
app.innerHTML=`<div class="wrap"><div class="bar2"><a href="#dojo">← Dojo</a><b>${ch.title} <span class="chip">${ch.cat}</span></b><span class="mono" id="tm">00:00</span><span>Reward <b id="rw" style="flex:none">${rw()}</b> XP</span><button class="btn" id="ai">Ask AI Sensei (−10 XP)</button><button class="btn" id="hb">Hint (−10 XP)</button></div>
<div class="grid"><div><div class="card"><p style="margin:0">${ch.story}</p></div><div id="hs"></div>${edHTML}</div>${termHTML}</div></div>`;
$('#rw').textContent=rw();TM=setInterval(()=>$('#tm').textContent=fmt((Date.now()-t0)/1000|0),1000);
$('#hb').onclick=()=>{if(hn>=ch.hints.length)return;const d=document.createElement('div');d.className='hint';d.textContent='Sensei: '+ch.hints[hn++];$('#hs').appendChild(d);$('#rw').textContent=rw();if(hn>=ch.hints.length)$('#hb').disabled=true};
boot(ch);chat(ch,()=>{hn++;$('#rw').textContent=rw()});
$('#ai').onclick=async()=>{const d=document.createElement('div');d.className='hint';d.textContent='Sensei is thinking...';$('#hs').appendChild(d);hn++;$('#rw').textContent=rw();
const files={};ch.edit.forEach(e=>{const k=e[0]==='/'?e:HOME+'/'+e;if(fs[k])files[e]=fs[k].c});
try{const r=await fetch('/api/sensei',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({challenge:id,history:S.hist.slice(-8),files})});const j=await r.json();d.textContent='Sensei'+(j.source==='claude'?' (AI)':'')+': '+(j.answer||j.error)}catch(e){d.textContent='Sensei is offline here - use the Hint button.'}};
S.onWin=()=>{clearT();const t=(Date.now()-t0)/1000|0,first=!SV.done[id]&&id!=='gen',gain=first?rw():0,b0=belt(SV.xp);if(first){SV.done[id]={t,h:hn};SV.xp+=gain;if(SV.last!==day()){SV.streak=SV.last===day(1)?SV.streak+1:1;SV.last=day()}save();sync()}const b1=belt(SV.xp),nx=CH.find(c=>!SV.done[c.id]);
setTimeout(()=>{const m=document.createElement('div');m.className='modal';m.innerHTML=`<div class="card" role="dialog" aria-modal="true" aria-label="Challenge solved"><div class="big">+${gain} XP</div><h3 style="margin:4px 0">${first?'Bug squashed!':'Practice run complete'}</h3><p class="mono" style="color:var(--m);font-size:13px">Time ${fmt(t)} · Hints ${hn}${b1!==b0?' · New belt: <b style="color:'+b1[2]+'">'+b1[0]+'</b>':''}</p><p><b>What was wrong:</b> ${ch.why}</p><div style="display:flex;gap:10px;flex-wrap:wrap"><a class="btn glow" style="padding:10px 20px;font-size:16px" href="${nx?'#ch-'+nx.id:'#cert'}">${nx?'Next challenge':'Get your certificate'}</a><button class="btn" id="cl">Keep playing</button><button class="btn" id="sh">Share</button></div></div>`;document.body.appendChild(m);$('#cl').focus();
$('#cl').onclick=()=>m.remove();$('#sh').onclick=()=>{const msg=`I fixed "${ch.title}" in ${fmt(t)} on Debug Dojo. Beat my time! ${location.origin}${location.pathname}#ch-${id}`;try{(navigator.share?navigator.share({text:msg}):navigator.clipboard.writeText(msg).then(()=>{$('#sh').textContent='Copied!'})).catch(()=>{})}catch(e){}};m.querySelector('a').onclick=()=>m.remove();
for(let i=0;i<36;i++){const c=document.createElement('i');c.className='cf';c.style.cssText=`--x:${(Math.random()-.5)*600}px;--y:${Math.random()*400-250}px;background:${['#39ff88','#27e0ff','#ffd166'][i%3]}`;document.body.appendChild(c);setTimeout(()=>c.remove(),1500)}},500)}}
function dojo(){const b=belt(SV.xp),nx=BELTS[BELTS.indexOf(b)+1],pct=nx?Math.round((SV.xp-b[1])/(nx[1]-b[1])*100):100,rows=[...RIV,['You',SV.xp]].sort((a,c)=>c[1]-a[1]);
app.innerHTML=`<div class="wrap"><h2>Your dojo</h2>${USER?`<p style="color:var(--m);margin-top:-14px">Signed in as <b>${USER.username}</b>. Progress syncs to your account.</p>`:`<p style="color:var(--m);margin-top:-14px">Guest mode. <a href="#login">Log in</a> to sync progress and join the live leaderboard.</p>`}<div class="top2"><div class="card"><span>Level</span><b>${Math.floor(SV.xp/100)+1}</b></div><div class="card"><span>XP</span><b>${SV.xp}</b></div><div class="card"><span>Belt</span><b style="color:${b[2]}">${b[0]}</b><div class="bar"><i style="width:${pct}%"></i></div><small style="color:var(--m)">${nx?nx[1]-SV.xp+' XP to '+nx[0]:'Max belt'}</small></div><div class="card"><span>Streak</span><b>🔥 ${stk()}d</b></div></div>
<h2>Challenges</h2><div class="cards">${CH.map(c=>`<a class="cc ${SV.done[c.id]?'done':''}" href="#ch-${c.id}"><span class="chip">${c.cat}</span><h3 style="margin:8px 0 4px">${c.title}</h3><span style="color:var(--m)">${c.xp} XP ${SV.done[c.id]?'· ✔ '+fmt(SV.done[c.id].t):''}</span></a>`).join('')}<a class="cc" href="#lab" style="border-style:dashed"><span class="chip">Sandbox</span><h3 style="margin:8px 0 4px">Linux Lab</h3><span style="color:var(--m)">Free practice, no goals</span></a><a class="cc" href="#gen" style="border-style:dashed"><span class="chip">AI</span><h3 style="margin:8px 0 4px">AI challenge lab</h3><span style="color:var(--m)">Claude builds a new broken setup</span></a><a class="cc" href="#room" style="border-style:dashed"><span class="chip">Team</span><h3 style="margin:8px 0 4px">Team rooms</h3><span style="color:var(--m)">Class or company leaderboard</span></a></div>
<h2 style="margin-top:44px">Certificate</h2>${dn()>=CH.length?'<a class="btn glow" href="#cert">Get your certificate</a>':'<p style="color:var(--m)">Finish all '+CH.length+' challenges to unlock it ('+dn()+' done).</p>'}<h2 style="margin-top:44px">Badges</h2><ul class="bg">${BADGES.map(([n,d,f])=>`<li class="${f()?'on':''}"><b>${n}</b><span>${d}</span></li>`).join('')}</ul>
<h2 style="margin-top:44px">Leaderboard</h2><div class="card lb" id="lb" style="margin-bottom:50px">${rows.map((r,i)=>`<div class="${r[0]==='You'?'me':''}"><span>${i+1}. ${r[0]}</span><span class="mono">${r[1]} XP</span></div>`).join('')}<small style="color:var(--m)">Rivals are sample data; your score is saved in this browser.</small></div></div>`;
fetch('/api/leaderboard').then(r=>r.json()).then(L=>{if(!Array.isArray(L)||!L.length||!$('#lb'))return;$('#lb').innerHTML=L.map((r,i)=>`<div class="${r.id===SV.id?'me':''}"><span>${i+1}. ${r.id===SV.id?'You':r.name}</span><span class="mono">${r.xp} XP</span></div>`).join('')+'<small style="color:var(--m)">Live from the Dojo server.</small>'}).catch(()=>{})}
function home(){app.innerHTML=`<section class="hero"><canvas aria-hidden="true"></canvas><div class="wrap hg"><div><h1>Break it.<br>Debug it.<br>Master it.</h1><p class="lead">Fix broken Linux systems and close real security holes in a safe in-browser terminal. Earn XP, climb belts.</p><a class="btn glow" id="go" href="#login">Start Training</a> <a class="btn" href="#lab" style="margin-left:8px">Open Linux Lab</a></div>
<div class="demo" aria-label="Animated terminal demo"><div class="tb"><i></i><i></i><i></i><span style="margin-left:8px">dojo@dojo</span></div><div class="bd" id="dm"></div></div></div></section>
<div class="stats"><div><b>${CH.length}</b><span>challenges</span></div><div><b>5</b><span>belts</span></div><div><b>${new Set(CH.map(c=>c.cat)).size}</b><span>categories</span></div><div><b>30+</b><span>Linux commands</span></div></div>
<section class="s"><div class="wrap"><h2>How it works</h2><div class="cards">
<div class="card rv"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 1v4M12 19v4M1 12h4M19 12h4"/></svg><h3>Pick a challenge</h3><p>Each one is a broken real-world setup with a short story.</p></div>
<div class="card rv"><svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M6 10l3 2-3 2M12 15h5"/></svg><h3>Fix it in the terminal</h3><p>A mini Linux shell plus a config editor. Commands behave like the real thing.</p></div>
<div class="card rv"><svg viewBox="0 0 24 24"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 01-10 0zM7 6H3v2a4 4 0 004 4M17 6h4v2a4 4 0 01-4 4"/></svg><h3>Earn XP and belts</h3><p>Fewer hints and faster fixes pay more. Keep your streak alive.</p></div></div></div></section>
<section class="s" style="padding-top:0"><div class="wrap"><h2>Belt progression</h2><div class="belts rv">${BELTS.map(b=>`<div class="bt" style="background:${b[2]}">${b[0]}<br><small>${b[1]} XP</small></div>`).join('')}</div></div></section>
<footer>Debug Dojo · built for DevOps practice · <a href="https://github.com" target="_blank" rel="noopener">GitHub</a></footer>`;
bg($('canvas'));demo($('#dm'));if(USER)$('#go').href='#lab';const io=new IntersectionObserver(es=>es.forEach(e=>e.isIntersecting&&e.target.classList.add('in')),{threshold:.2});document.querySelectorAll('.rv').forEach(e=>io.observe(e))}
function bg(cv){const x=cv.getContext('2d'),red=matchMedia('(prefers-reduced-motion:reduce)').matches;let W,Hh,P=[];const rs=()=>{W=cv.width=cv.offsetWidth;Hh=cv.height=cv.offsetHeight;P=Array.from({length:Math.min(60,W/18|0)},()=>({x:Math.random()*W,y:Math.random()*Hh,vx:(Math.random()-.5)*.3,vy:(Math.random()-.5)*.3}))};rs();addEventListener('resize',rs);
(function f(){if(!document.body.contains(cv))return;x.clearRect(0,0,W,Hh);P.forEach((p,i)=>{if(!red){p.x=(p.x+p.vx+W)%W;p.y=(p.y+p.vy+Hh)%Hh}x.globalAlpha=.7;x.fillStyle='#39ff88';x.fillRect(p.x,p.y,2,2);for(let j=i+1;j<P.length;j++){const q=P[j],d=Math.hypot(p.x-q.x,p.y-q.y);if(d<110){x.globalAlpha=(1-d/110)*.25;x.strokeStyle='#27e0ff';x.beginPath();x.moveTo(p.x,p.y);x.lineTo(q.x,q.y);x.stroke()}}});if(!red)requestAnimationFrame(f)})()}
async function demo(el){const w=ms=>new Promise(r=>setTimeout(r,ms)),alive=()=>document.body.contains(el),line=c=>{const d=document.createElement('div');d.className='ln '+(c||'');el.appendChild(d);return d};
const type=async t=>{const d=line();d.innerHTML='<span class="pr">$</span> <span></span><i class="cur"></i>';const s=d.children[1];for(const c of t){if(!alive())return;s.textContent+=c;await w(55)}d.querySelector('.cur').remove();await w(400)};
while(alive()){el.innerHTML='';await type('ssh -i ~/.ssh/id_rsa prod');if(!alive())return;line('e').textContent='WARNING: UNPROTECTED PRIVATE KEY FILE! (mode 0644)';await w(1500);await type('chmod 600 ~/.ssh/id_rsa');if(!alive())return;line('o').textContent='✔ Connected to prod. Key is safe.';const x=document.createElement('div');x.className='xp';x.textContent='+50 XP';el.parentElement.appendChild(x);await w(2800);x.remove();await w(500)}}
function route(){clearT();document.querySelectorAll('.modal').forEach(m=>m.remove());const h=location.hash.slice(1)||'home';if(SERVER&&!USER&&/^(dojo|lab|cert|gen|room.*|ch-.+)$/.test(h)){location.hash='login';return}if(h==='dojo')dojo();else if(h==='lab')lab();else if(h==='login')login();else if(h==='cert')cert();else if(h==='gen')gen();else if(h.startsWith('room'))room(h.slice(5));else if(h.startsWith('ch-'))chal(h.slice(3));else home();scrollTo(0,0)}
let SND=false,AC=null;try{SND=localStorage.getItem('dd_snd')==='1';document.documentElement.dataset.theme=localStorage.getItem('dd_theme')||'dark'}catch(e){}
const beep=()=>{try{AC=AC||new (window.AudioContext||window.webkitAudioContext)();const o=AC.createOscillator(),g=AC.createGain();o.frequency.value=600+Math.random()*200;g.gain.value=.03;o.connect(g);g.connect(AC.destination);o.start();o.stop(AC.currentTime+.03)}catch(e){}};
const setSnd=()=>{$('#sn').textContent=SND?'🔊':'🔇';$('#sn').setAttribute('aria-pressed',String(SND))};setSnd();
$('#th').onclick=()=>{const t=document.documentElement.dataset.theme==='light'?'dark':'light';document.documentElement.dataset.theme=t;try{localStorage.setItem('dd_theme',t)}catch(e){}};
$('#sn').onclick=()=>{SND=!SND;try{localStorage.setItem('dd_snd',SND?'1':'0')}catch(e){}setSnd();if(SND)beep()};
document.addEventListener('keydown',e=>{if(SND&&e.target&&e.target.id==='I'&&e.key.length===1)beep()});
addEventListener('hashchange',route);setAu();init().then(route);
</script></body></html>
